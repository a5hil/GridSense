# ==========================================
# GridSense Root GitIgnore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node.js & Web Dashboard
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# Environment & Secrets (Never commit secrets)
.env
.env*.local
*.pem
*.key

# Embedded / Arduino / PlatformIO Build Artifacts
**/.pio/
**/.pioenvs/
**/.piolibdeps/
**/.clangd/
**/.ccls-cache/
**/*.bin
**/*.hex
**/*.elf
**/*.map
**/*.o
**/*.d

# Test Artifacts & Playwright Reports
test-results/
playwright-report/
**/test-results/
**/playwright-report/
