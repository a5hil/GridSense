# =============================================================================
# GridSense SCADA Web Dashboard - Environment Variables Template
# Copy this file to .env.local to customize your local configuration.
# The dashboard operates with full zero-config fallbacks even if this file is missing.
# =============================================================================

# Mapbox Access Token (Optional)
# If omitted or unauthorized, the dashboard automatically falls back to Carto high-resolution SCADA vector tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# MongoDB Database Connection (Optional)
# If MongoDB service is offline, the dashboard seamlessly activates in-memory circular buffers.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gridsense

# Hardware USB Serial Port (Optional)
# If physical ESP32 gateway is not connected, the embedded SCADA simulation engine provides live telemetry.
SERIAL_PORT=COM8

# SCADA Operator Authentication & HMAC Token Secret (Recommended for Production)
# Must be at least 32 characters long. If omitted in development, a built-in dev secret is used.
AUTH_SECRET=gridsense-scada-hmac-secret-viva2026-secure

# Cloud Serial Bridge (Optional - for remote Render hosting)
# Secret token to authorize local bridge forwarding packets to your deployed cloud dashboard.
BRIDGE_SECRET=gridsense-telemetry-bridge-viva-2026
